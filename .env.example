# CampusPrep Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Supabase Integration Credentials
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Cloud PostgreSQL Database Connection (Supabase Pooler)
DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SESSION_COOKIE_SECURE=False
